# ==============================================================================
# CivicPulse AI - Environment Configuration Example
# Copy this file to `server/.env` and `client/.env` as appropriate.
# Never commit `.env` containing real keys to version control.
# ==============================================================================

# --- SERVER ENVIRONMENT VARIABLES ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Firebase Admin SDK (Server)
FIREBASE_PROJECT_ID=civicpulse-vizag
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@civicpulse-vizag.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=civicpulse-vizag.appspot.com

# JWT Secret (for session / mock token validation)
JWT_SECRET=civicpulse-secret-jwt-token-vizag-2025

# --- CLIENT ENVIRONMENT VARIABLES (Vite prefix: VITE_) ---
VITE_API_BASE_URL=http://localhost:5000/api
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=civicpulse-vizag.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=civicpulse-vizag
VITE_FIREBASE_STORAGE_BUCKET=civicpulse-vizag.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_ENABLE_MOCK_AUTH=true

